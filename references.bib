@book{Dobert.2014,
 abstract = {Dieses Handbuch besch{\"a}ftigt sich mit den drei thematischen Schwerpunkten {\glqq}kommunales Bildungsmonitoring{\grqq}, kommunales Bildungsmanagement{\grqq} und {\glqq}Bildungssteuerung in Kommunen{\grqq} und st{\"u}tzt sich dabei zu einem gro{\ss}en Teil auf Erfahrungen mit dem BMBF-Programm {\glqq}Lernen vor Ort{\grqq} (LvO). Der Band richtet sich an bildungspolitisch Verantwortliche in Kommunen, Mitarbeiter in kommunalen {\"A}mtern und alle an Steuerungsfragen im Bildungswesen Interessierten in Forschung und Bildungspraxis.



Fragen der Verbesserung von Qualit{\"a}t und Chancengerechtigkeit im deutschen Bildungssystem sind seit l{\"a}ngerer Zeit vermehrt in den Fokus des bildungspolitischen Interesses ger{\"u}ckt. Vielerorts sind bereits Ma{\ss}nahmen in die Wege geleitet worden, die darauf abzielen, die Qualit{\"a}t von Bildungseinrichtungen, den Bildungserfolg des Einzelnen sowie die Chancengerechtigkeit im Bildungswesen zu verbessern. Dabei sind die Kommunen besonders gefordert, weil nur sie {\"u}ber die Bildungsbereiche hinweg ein leistungsf{\"a}higes und den Interessen ihrer B{\"u}rger entsprechendes Bildungsangebot bereitstellen k{\"o}nnen. Damit dies gelingen kann, entschlie{\ss}en sich immer mehr Kommunen zu einem regelm{\"a}{\ss}igen, wissenschaftlich fundierten, kommunalen Bildungsmonitoring. Erfahrungen haben gezeigt, dass dies eine unentbehrliche Grundlage f{\"u}r ein modernes Bildungsmanagement sowie die Entwicklung eines koh{\"a}renten Bildungswesens {\"u}ber die einzelnen Bildungsbereiche hinweg ist: Erst die systematische, empirisch belastbare und fokussierende Zusammenschau zentraler Informationen der Bildungsentwicklung erm{\"o}glicht es Kommunen, fundierte Handlungsstrategien abzuleiten.Dieses Handbuch besch{\"a}ftigt sich in seinen drei thematischen Schwerpunkten {\glqq}kommunales Bildungsmonitoring{\grqq}, kommunales Bildungsmanagement{\grqq} und {\glqq}Bildungssteuerung in Kommunen{\grqq} mit diesen Zusammenh{\"a}ngen und st{\"u}tzt sich dabei zu einem gro{\ss}en Teil auf Erfahrungen mit dem BMBF-Programm {\glqq}Lernen vor Ort{\grqq} (LvO). Der Band richtet sich an bildungspolitisch Verantwortliche in Kommunen, Mitarbeiter in kommunalen {\"A}mtern und alle an Steuerungsfragen im Bildungswesen Interessierten in Forschung und Bildungspraxis},
 year = {2014},
 title = {Bildungsmonitoring, Bildungsmanagement und Bildungssteuerung in Kommunen: Ein Handbuch},
 url = {https://elibrary.utb.de/doi/book/10.31244/9783830981831},
 address = {M{\"u}nster and New York},
 publisher = {{Waxmann Verlag}},
 isbn = {978-3-8309-8183-1},
 series = {Waxmann-E-Books Empirische Erziehungswissenschaft},
 editor = {D{\"o}bert, Hans}
}


