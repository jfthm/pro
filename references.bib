 doi = {10.25656/01:17790},
 file = {Fickermann{\_}Weishaupt{\_}2019{\_}Bildungsforschung{\_}mit{\_}Daten{\_}4{\_}Hogrebe{\_}Pomykaj{\_}Die{\_}Schuleingangsuntersuchung{\_}als{\_}Datenquelle:Attachments/Fickermann{\_}Weishaupt{\_}2019{\_}Bildungsforschung{\_}mit{\_}Daten{\_}4{\_}Hogrebe{\_}Pomykaj{\_}Die{\_}Schuleingangsuntersuchung{\_}als{\_}Datenquelle.pdf:application/pdf}
