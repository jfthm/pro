@book{Wildgruber.2016,
 abstract = {Der {\"U}bergang von der Kindertageseinrichtung in die Grundschule bedeutet f{\"u}r Kinder wie auch f{\"u}r deren Eltern Abschied und Neubeginn zugleich. Ein reibungsloser Wechsel vom Elementar- zum Primarbereich wird jedoch bereits durch die Strukturdifferenz beider Bildungsorte erschwert -- bis heute ist der {\"U}bergang in hohem Ma{\ss} durch Segregation und Selektion gepr{\"a}gt. In der vorliegenden Expertise beleuchten Andreas Wildgruber und Wilfried Griebel die curriculare Anschlussf{\"a}higkeit von Kindertageseinrichtung und Schule. Sie pr{\"a}sentieren den internationalen Forschungsstand zum Thema und er{\"o}rtern das Konstrukt {\"U}bergang hinsichtlich seiner spezifischen Bedeutungsebenen Kind, Familie, Institution und Sozialraum.},
 author = {Wildgruber, Andreas and Griebel, Wilfried},
 year = {2016},
 title = {Erfolgreicher {\"U}bergang vom Elementar- in den Primarbereich: Empirische und curriculare Analysen},
 url = {https://www.weiterbildungsinitiative.de/publikationen/detail/erfolgreicher-uebergang-vom-elementar-in-den-primarbereich},
 price = {(kostenfrei) (ISBN 978-3-86379-141-4 (kostenfrei)},
 address = {M{\"u}nchen},
 volume = {44},
 publisher = {{Deutsches Jugendinstitut}},
 isbn = {978-3-86379-141-4},
 series = {WiFF-Expertisen},
 institution = {{Deutsches Jugendinstitut}},
 file = {Exp{\_}Wildgruber{\_}Griebel{\_}web:Attachments/Exp{\_}Wildgruber{\_}Griebel{\_}web.pdf:application/pdf}
}


@phdthesis{WinklerHahn.2024,
 abstract = {Im Spannungsfeld der fr{\"u}hkindlichen Bildung, Schule und Sprachtherapie ist multifaktorielle Expertise gefragt, um sprachliche F{\"a}higkeiten von Kindern einzusch{\"a}tzen und gegebenenfalls geeignete F{\"o}rder- oder Therapiema{\ss}nahmen abzuleiten. Ziel der Arbeit war es, die Versorgungssituation bez{\"u}glich der Einsch{\"a}tzung der kindlichen Sprachentwicklung zu rekonstruieren sowie f{\"o}rdernde und hemmende Faktoren zu identifizieren. Als Methodik wurde ein explorativer, sequentieller Mixed-Methods-Ansatz gew{\"a}hlt. In diesem Rahmen entstand der Entwurf eines interprofessionellen Beurteilungsinstruments f{\"u}r die Einsch{\"a}tzung der sprachlichen F{\"a}higkeiten von Kindern. Das Instrument wurde mit einer schriftlichen Befragung evaluiert. Das langfristig angestrebte Ziel ist die Gestaltung interprofessioneller Netzwerke {\"u}ber eine zentrale, sichere, niedrigschwellige und digitale Dokumentations- und Austauschplattform f{\"u}r die fallzentrierte Zusammenarbeit.

Across daycare, school and speech and language therapy (SLT), multifactorial expertise is required to assess the language skills of children and, if necessary, define suitable support. The structural complexity of health care, welfare and public education poses a particular challenge. The aim of the work was initially to reconstruct the care situation, including the interprofessional processes and structures relating to the assessment of children's language development, and to identify factors that promote and inhibit the collaboration. Research questions and project objectives were addressed using an explorative, sequential mixed-methods approach. On the basis of these results, an interprofessional assessment tool was developed for the assessment of children's language skills in the transition from nursery to school. This should enable an interprofessional exchange across systems and organizations in a central and asynchronous form. The long-term-goal is to create and sustain interprofes-sional networks through a central, secure, low-threshold and digital documentation and exchange platform for case-centred cooperation.},
 author = {Winkler-Hahn, Stefanie},
 year = {2024},
 title = {Interprofessionelle Einsch{\"a}tzung der kindlichen Sprachentwicklung : Entwicklung und Evaluation eines digitalen Instruments},
 school = {{Universit{\"a}ts- und Landesbibliothek Sachsen-Anhalt}},
 doi = {10.25673/116674}
}


