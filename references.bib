@phdthesis{Zein.2024,
 abstract = {Sprachentwicklungsst{\"o}rungen als Bildungsrisiko k{\"o}nnen zu erheblichen schulischen Defiziten f{\"u}hren. Daher wurde der Verlauf der sprachlichen und schulleistungsbezogenen Entwicklung in Schriftsprache und Mathematik von sprachbeeintr{\"a}chtigten Kindern im Vergleich zu sprachunauff{\"a}lligen Kindern bis zum Ende der Grundschulzeit und die Inanspruchnahme sprachlichen F{\"o}rderma{\ss}nahmen im Rahmen einer multizentrischen, prospektiv kontrollierten Kohortenstudie (n=71) untersucht. Sprachbeeintr{\"a}chtigte Kinder (n=35) zeigten signifikant schlechtere Sprachleistungen, wobei 65 Prozent nicht der Altersnorm entsprachen. Zudem wiesen sie durchg{\"a}ngig schlechtere Schulleistungen auf, insbesondere bei verringerter Grammatikkompetenz und Zuerkennung eines sonderp{\"a}dagogischen Sprachf{\"o}rderbedarfes. F{\"u}r sprachbeeintr{\"a}chtigte Kinder besteht ein besonderes Bildungsrisiko durch bestehende Lernbarrieren im inklusiven Bildungssystem und somit eine Gef{\"a}hrdung der bildungsbezogenen und gesellschaftlichen Teilhabe.

Language development disorders as an educational risk can lead to significant academic deficits. This study investigated the development of language and academic performance in literacy and mathematics among children with language impairments compared to unaffected peers, up to the end of primary school. Additionally, the use of language support measures was examined within a multicenter, prospective controlled cohort study (n=71). Children with language impairments (n=35) showed significantly lower language skills, with 65 percent not meeting age norms. They also consistently performed worse academically, especially with reduced grammatical competence and special educational language needs. Language-impaired children face higher educational risks due to learning barriers in inclusive education, endangering both educational and social participation.},
 author = {Zein, Katrin},
 year = {2024},
 title = {Die schulische Entwicklung von sprachauff{\"a}lligen Kindern : Kohortenstudie zur Schulbiografie sprachauff{\"a}lliger Kinder in Th{\"u}ringer Grundschulen},
 school = {{Universit{\"a}ts- und Landesbibliothek Sachsen-Anhalt}},
 doi = {10.25673/116973}
}


